<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\NorthwindRAG.Core\NorthwindRAG.Core.csproj" />
    <ProjectReference Include="..\NorthwindRAG.Infrastructure\NorthwindRAG.Infrastructure.csproj" />
    <ProjectReference Include="..\NorthwindRAG.SemanticKernel\NorthwindRAG.SemanticKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Qdrant.Client" Version="1.15.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssetTargetFallback>$(AssetTargetFallback);net8.0</AssetTargetFallback>
    <NoWarn>$(NoWarn);SKEXP0001;SKEXP0010;SKEXP0020;SKEXP0050;SKEXP0070</NoWarn>
    <!-- Server GC breaks outbound SSL in .NET 10 on this network (router blocks TLS ClientHello from Server GC processes) -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <AssemblyName>NorthwindWebApi</AssemblyName>
  </PropertyGroup>

</Project>
